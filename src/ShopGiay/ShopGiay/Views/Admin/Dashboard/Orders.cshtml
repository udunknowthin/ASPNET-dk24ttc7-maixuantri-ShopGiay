@model ShopGiay.Models.AdminOrderListViewModel
@{
    ViewBag.Title = "Quản lý đơn hàng";
    ViewBag.PaginationPage = Model.Page;
    ViewBag.PaginationTotalPages = Model.TotalPages;
    ViewBag.PaginationAction = "Orders";
    ViewBag.PaginationController = "Admin";
    ViewBag.PaginationRouteValues = new System.Collections.Generic.Dictionary<string, object>
    {
        { "keyword",  Model.SearchKeyword },
        { "fromDate", Model.FromDate.HasValue  ? Model.FromDate.Value.ToString("yyyy-MM-dd")  : null },
        { "toDate",   Model.ToDate.HasValue    ? Model.ToDate.Value.ToString("yyyy-MM-dd")    : null },
        { "status",   Model.StatusFilter.HasValue ? (object)(int)Model.StatusFilter.Value : null }
    };
    var _fromStr = Model.FromDate.HasValue ? Model.FromDate.Value.ToString("yyyy-MM-dd") : string.Empty;
    var _toStr   = Model.ToDate.HasValue   ? Model.ToDate.Value.ToString("yyyy-MM-dd")   : string.Empty;
}

<div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-4">
    <h2 class="fw-bold mb-0">📦 Quản lý đơn hàng</h2>
    @Html.ActionLink("← Dashboard", "Index", "Admin", null, new { @class = "btn btn-outline-secondary btn-sm" })
</div>

<!-- Bộ lọc -->
<div class="card border-0 shadow-sm mb-4">
    <div class="card-body">
        @using (Html.BeginForm("Orders", "Admin", FormMethod.Get, new { @class = "row g-2 align-items-end" }))
        {
            <div class="col-12 col-md-3">
                <label class="form-label fw-semibold">Từ khóa</label>
                <input type="text" name="keyword" value="@Model.SearchKeyword" class="form-control" placeholder="Tên, email, SĐT..." />
            </div>
            <div class="col-6 col-md-2">
                <label class="form-label fw-semibold">Từ ngày</label>
                <input type="date" name="fromDate" value="@_fromStr" class="form-control" />
            </div>
            <div class="col-6 col-md-2">
                <label class="form-label fw-semibold">Đến ngày</label>
                <input type="date" name="toDate" value="@_toStr" class="form-control" />
            </div>
            <div class="col-12 col-md-3">
                <label class="form-label fw-semibold">Trạng thái</label>
                <select name="status" class="form-select">
                    <option value="">-- Tất cả --</option>
                    <option value="0" @(Model.StatusFilter.HasValue && Model.StatusFilter.Value == ShopGiay.Models.OrderStatus.Pending    ? "selected" : "")>Chờ xử lý</option>
                    <option value="1" @(Model.StatusFilter.HasValue && Model.StatusFilter.Value == ShopGiay.Models.OrderStatus.Processing  ? "selected" : "")>Đang xử lý</option>
                    <option value="2" @(Model.StatusFilter.HasValue && Model.StatusFilter.Value == ShopGiay.Models.OrderStatus.Shipped     ? "selected" : "")>Đã giao vận chuyển</option>
                    <option value="3" @(Model.StatusFilter.HasValue && Model.StatusFilter.Value == ShopGiay.Models.OrderStatus.Delivered   ? "selected" : "")>Đã giao hàng</option>
                    <option value="4" @(Model.StatusFilter.HasValue && Model.StatusFilter.Value == ShopGiay.Models.OrderStatus.Cancelled   ? "selected" : "")>Đã hủy</option>
                </select>
            </div>
            <div class="col-12 col-md-2">
                <button type="submit" class="btn btn-primary w-100">🔍 Lọc</button>
            </div>
        }
    </div>
</div>

<div class="d-flex justify-content-between align-items-center mb-2 small text-muted">
    <span>Tổng: <strong>@Model.TotalCount</strong> đơn — Trang <strong>@Model.Page</strong>/@Model.TotalPages</span>
</div>

<!-- Bảng đơn hàng -->
<div class="card border-0 shadow-sm">
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover mb-0 admin-table">
                <thead class="table-light">
                    <tr>
                        <th>#</th>
                        <th>Khách hàng</th>
                        <th class="d-none d-md-table-cell">Email</th>
                        <th class="d-none d-lg-table-cell">SĐT</th>
                        <th>Tổng tiền</th>
                        <th>Trạng thái</th>
                        <th class="d-none d-sm-table-cell">Ngày tạo</th>
                        <th>Cập nhật TT</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model.Orders != null && Model.Orders.Count > 0)
                    {
                        foreach (var o in Model.Orders)
                        {
                            var isLocked = o.Status == ShopGiay.Models.OrderStatus.Delivered
                                        || o.Status == ShopGiay.Models.OrderStatus.Cancelled;
                            <tr>
                                <td class="fw-semibold">#@o.Id</td>
                                <td>@o.FullName</td>
                                <td class="d-none d-md-table-cell">@o.Email</td>
                                <td class="d-none d-lg-table-cell">@o.PhoneNumber</td>
                                <td class="text-nowrap">@o.TotalAmount.ToString("N0")₫</td>
                                <td>@Html.Partial("_OrderStatusBadge", o.Status)</td>
                                <td class="d-none d-sm-table-cell text-nowrap">@o.CreatedAt.ToString("dd/MM/yyyy")</td>
                                <td>
                                    @using (Html.BeginForm("UpdateOrderStatus", "Admin", FormMethod.Post, new { @class = "d-inline" }))
                                    {
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="orderId" value="@o.Id" />
                                        <input type="hidden" name="page" value="@Model.Page" />
                                        <input type="hidden" name="keyword" value="@Model.SearchKeyword" />
                                        <input type="hidden" name="fromDate" value="@_fromStr" />
                                        <input type="hidden" name="toDate" value="@_toStr" />
                                        if (Model.StatusFilter.HasValue)
                                        {
                                            <input type="hidden" name="statusFilter" value="@((int)Model.StatusFilter.Value)" />
                                        }
                                        if (isLocked)
                                        {
                                            <span class="badge bg-secondary">🔒 Đã chốt</span>
                                        }
                                        else
                                        {
                                            <select name="status" class="form-select form-select-sm" style="min-width:130px;"
                                                    data-original="@((int)o.Status)" onchange="confirmStatusChange(this)">
                                                <option value="0" @(o.Status == ShopGiay.Models.OrderStatus.Pending    ? "selected" : "")>Chờ xử lý</option>
                                                <option value="1" @(o.Status == ShopGiay.Models.OrderStatus.Processing ? "selected" : "")>Đang xử lý</option>
                                                <option value="2" @(o.Status == ShopGiay.Models.OrderStatus.Shipped    ? "selected" : "")>Vận chuyển</option>
                                                <option value="3" @(o.Status == ShopGiay.Models.OrderStatus.Delivered  ? "selected" : "")>Đã giao</option>
                                                <option value="4" @(o.Status == ShopGiay.Models.OrderStatus.Cancelled  ? "selected" : "")>Đã hủy</option>
                                            </select>
                                        }
                                    }
                                </td>
                                <td>
                                    <button type="button" class="btn btn-outline-info btn-sm"
                                            data-bs-toggle="collapse" data-bs-target="#od-@o.Id"
                                            title="Xem chi tiết đơn hàng">🔍</button>
                                </td>
                            </tr>
                            <tr>
                                <td colspan="9" class="p-0" style="border-top:0;">
                                    <div id="od-@o.Id" class="collapse">
                                        <div class="p-3 bg-light border-start border-4 border-info small">
                                            <div class="row g-2 mb-2">
                                                <div class="col-sm-5"><strong>📍 Địa chỉ:</strong> @o.Address</div>
                                                <div class="col-sm-3"><strong>💳 Thanh toán:</strong> @o.PaymentMethod</div>
                                                @if (!string.IsNullOrWhiteSpace(o.Notes))
                                                {
                                                    <div class="col-sm-4"><strong>📝 Ghi chú:</strong> @o.Notes</div>
                                                }
                                            </div>
                                            <div class="table-responsive">
                                                <table class="table table-sm table-bordered mb-0 bg-white">
                                                    <thead class="table-light">
                                                        <tr>
                                                            <th>Sản phẩm</th>
                                                            <th class="d-none d-sm-table-cell">Kích cỡ</th>
                                                            <th class="text-end">Đơn giá</th>
                                                            <th class="text-center">SL</th>
                                                            <th class="text-end">Thành tiền</th>
                                                        </tr>
                                                    </thead>
                                                    <tbody>
                                                        @if (o.OrderItems != null)
                                                        {
                                                            foreach (var item in o.OrderItems)
                                                            {
                                                                <tr>
                                                                    <td>
                                                                        @if (!string.IsNullOrWhiteSpace(item.ProductImageUrl))
                                                                        {
                                                                            <img src="@item.ProductImageUrl" style="width:32px;height:32px;object-fit:cover;" class="rounded me-1" />
                                                                        }
                                                                        @item.ProductName
                                                                    </td>
                                                                    <td class="d-none d-sm-table-cell">@item.SizeName</td>
                                                                    <td class="text-end text-nowrap">@item.UnitPrice.ToString("N0")₫</td>
                                                                    <td class="text-center">@item.Quantity</td>
                                                                    <td class="text-end text-nowrap fw-semibold">@((item.UnitPrice * item.Quantity).ToString("N0"))₫</td>
                                                                </tr>
                                                            }
                                                        }
                                                    </tbody>
                                                </table>
                                            </div>
                                        </div>
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr><td colspan="9" class="text-center text-muted py-3">Không tìm thấy đơn hàng nào.</td></tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

@Html.Partial("_Pagination")

@section scripts {
    <script>
        var statusLabels = ['Chờ xử lý', 'Đang xử lý', 'Vận chuyển', 'Đã giao', 'Đã hủy'];
        function confirmStatusChange(select) {
            var newVal = parseInt(select.value);
            var orig   = parseInt(select.dataset.original);
            if (newVal === orig) return;
            var label  = statusLabels[newVal] !== undefined ? statusLabels[newVal] : newVal;
            if (confirm('Xác nhận cập nhật trạng thái đơn hàng thành:\n"' + label + '"?\n\nNhấn OK để xác nhận, Cancel để hủy bỏ.')) {
                select.form.submit();
            } else {
                select.value = orig;
            }
            }
        </script>
        }

