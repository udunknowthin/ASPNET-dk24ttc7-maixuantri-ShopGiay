@model ShopGiay.Models.AdminOrderListViewModel
@{
    ViewBag.Title = "Quản lý đơn hàng";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2 class="fw-bold mb-0">📦 Quản lý đơn hàng</h2>
    @Html.ActionLink("← Quay lại Dashboard", "Index", "Admin", null, new { @class = "btn btn-outline-secondary" })
</div>

<div class="card border-0 shadow-sm mb-4">
    <div class="card-body">
        @using (Html.BeginForm("Orders", "Admin", FormMethod.Get, new { @class = "row g-2 align-items-end" }))
        {
            <div class="col-md-3">
                <label class="form-label fw-semibold">Từ khóa</label>
                <input type="text" name="keyword" value="@Model.SearchKeyword" class="form-control" placeholder="Tên, email, SĐT..." />
            </div>
            <div class="col-md-2">
                <label class="form-label fw-semibold">Từ ngày</label>
                <input type="date" name="fromDate" value="@(Model.FromDate.HasValue ? Model.FromDate.Value.ToString("yyyy-MM-dd") : "")" class="form-control" />
            </div>
            <div class="col-md-2">
                <label class="form-label fw-semibold">Đến ngày</label>
                <input type="date" name="toDate" value="@(Model.ToDate.HasValue ? Model.ToDate.Value.ToString("yyyy-MM-dd") : "")" class="form-control" />
            </div>
            <div class="col-md-3">
                <label class="form-label fw-semibold">Trạng thái</label>
                <select name="status" class="form-select">
                    <option value="">-- Tất cả --</option>
                    <option value="0" @(Model.StatusFilter.HasValue && Model.StatusFilter.Value == ShopGiay.Models.OrderStatus.Pending ? "selected" : "")>Chờ xử lý</option>
                    <option value="1" @(Model.StatusFilter.HasValue && Model.StatusFilter.Value == ShopGiay.Models.OrderStatus.Processing ? "selected" : "")>Đang xử lý</option>
                    <option value="2" @(Model.StatusFilter.HasValue && Model.StatusFilter.Value == ShopGiay.Models.OrderStatus.Shipped ? "selected" : "")>Đã giao vận chuyển</option>
                    <option value="3" @(Model.StatusFilter.HasValue && Model.StatusFilter.Value == ShopGiay.Models.OrderStatus.Delivered ? "selected" : "")>Đã giao hàng</option>
                    <option value="4" @(Model.StatusFilter.HasValue && Model.StatusFilter.Value == ShopGiay.Models.OrderStatus.Cancelled ? "selected" : "")>Đã hủy</option>
                </select>
            </div>
            <div class="col-md-2">
                <button type="submit" class="btn btn-primary w-100">🔍 Lọc</button>
            </div>
        }
    </div>
</div>

<div class="card border-0 shadow-sm">
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover mb-0">
                <thead class="table-light">
                    <tr>
                        <th>#</th>
                        <th>Khách hàng</th>
                        <th>Email</th>
                        <th>SĐT</th>
                        <th>Tổng tiền</th>
                        <th>Trạng thái</th>
                        <th>Ngày tạo</th>
                        <th>Cập nhật</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model.Orders != null && Model.Orders.Count > 0)
                    {
                        foreach (var o in Model.Orders)
                        {
                            <tr>
                                <td>@o.Id</td>
                                <td>@o.FullName</td>
                                <td>@o.Email</td>
                                <td>@o.PhoneNumber</td>
                                <td>@o.TotalAmount.ToString("N0")₫</td>
                                <td>
                                    @switch (o.Status)
                                    {
                                        case ShopGiay.Models.OrderStatus.Pending:
                                            <span class="badge bg-warning text-dark">Chờ xử lý</span>
                                            break;
                                        case ShopGiay.Models.OrderStatus.Processing:
                                            <span class="badge bg-info text-dark">Đang xử lý</span>
                                            break;
                                        case ShopGiay.Models.OrderStatus.Shipped:
                                            <span class="badge bg-primary">Đã giao vận chuyển</span>
                                            break;
                                        case ShopGiay.Models.OrderStatus.Delivered:
                                            <span class="badge bg-success">Đã giao hàng</span>
                                            break;
                                        case ShopGiay.Models.OrderStatus.Cancelled:
                                            <span class="badge bg-danger">Đã hủy</span>
                                            break;
                                    }
                                </td>
                                <td>@o.CreatedAt.ToString("dd/MM/yyyy HH:mm")</td>
                                <td>
                                    @using (Html.BeginForm("UpdateOrderStatus", "Admin", FormMethod.Post, new { @class = "d-inline" }))
                                    {
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="orderId" value="@o.Id" />
                                        <select name="status" class="form-select form-select-sm d-inline-block" style="width:auto;" onchange="this.form.submit()">
                                            <option value="0" @(o.Status == ShopGiay.Models.OrderStatus.Pending ? "selected" : "")>Chờ xử lý</option>
                                            <option value="1" @(o.Status == ShopGiay.Models.OrderStatus.Processing ? "selected" : "")>Đang xử lý</option>
                                            <option value="2" @(o.Status == ShopGiay.Models.OrderStatus.Shipped ? "selected" : "")>Đã giao vận chuyển</option>
                                            <option value="3" @(o.Status == ShopGiay.Models.OrderStatus.Delivered ? "selected" : "")>Đã giao hàng</option>
                                            <option value="4" @(o.Status == ShopGiay.Models.OrderStatus.Cancelled ? "selected" : "")>Đã hủy</option>
                                        </select>
                                    }
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr><td colspan="8" class="text-center text-muted py-3">Không tìm thấy đơn hàng nào.</td></tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
