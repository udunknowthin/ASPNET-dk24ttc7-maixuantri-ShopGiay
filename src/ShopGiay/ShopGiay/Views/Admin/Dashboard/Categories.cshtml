@model ShopGiay.Models.AdminCategoryListViewModel
@{
    ViewBag.Title = "Quản lý danh mục";
}

<div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-4">
    <h2 class="fw-bold mb-0">📂 Quản lý danh mục</h2>
    <div class="d-flex flex-wrap gap-2">
        @Html.ActionLink("← Dashboard", "Index", "Admin", null, new { @class = "btn btn-outline-secondary btn-sm" })
        @Html.ActionLink("➕ Thêm danh mục", "CreateCategory", "Admin", null, new { @class = "btn btn-primary btn-sm" })
    </div>
</div>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success alert-dismissible fade show">@TempData["Success"] <button type="button" class="btn-close" data-bs-dismiss="alert"></button></div>
}
@if (TempData["Error"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show">@TempData["Error"] <button type="button" class="btn-close" data-bs-dismiss="alert"></button></div>
}

<!-- Tìm kiếm -->
<div class="card border-0 shadow-sm mb-4">
    <div class="card-body">
        @using (Html.BeginForm("Categories", "Admin", FormMethod.Get, new { @class = "row g-2 align-items-end" }))
        {
            <div class="col-12 col-md-8">
                <label class="form-label fw-semibold">Từ khóa</label>
                <input type="text" name="keyword" value="@Model.SearchKeyword" class="form-control" placeholder="Tên danh mục..." />
            </div>
            <div class="col-12 col-md-4">
                <button type="submit" class="btn btn-primary w-100">🔍 Tìm</button>
            </div>
        }
    </div>
</div>

<div class="d-flex justify-content-between align-items-center mb-2 small text-muted">
    <span>Tổng: <strong>@Model.TotalCount</strong> danh mục — Trang <strong>@Model.Page</strong>/@Model.TotalPages</span>
</div>

<div class="card border-0 shadow-sm">
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover mb-0 admin-table">
                <thead class="table-light">
                    <tr>
                        <th>#</th>
                        <th>Hình ảnh</th>
                        <th>Tên danh mục</th>
                        <th class="d-none d-md-table-cell">Mô tả</th>
                        <th class="d-none d-sm-table-cell">Sản phẩm</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model.Categories != null && Model.Categories.Count > 0)
                    {
                        foreach (var c in Model.Categories)
                        {
                            <tr>
                                <td>@c.Id</td>
                                <td>
                                    @if (!string.IsNullOrWhiteSpace(c.ImageUrl))
                                    {
                                        <img src="~/Content/images/categories/@c.ImageUrl" style="width:50px;height:50px;object-fit:cover;" class="rounded" />
                                    }
                                    else
                                    {
                                        <span class="text-muted small">Chưa có</span>
                                    }
                                </td>
                                <td class="fw-semibold">@c.Name</td>
                                <td class="d-none d-md-table-cell text-muted small">@(string.IsNullOrWhiteSpace(c.Description) ? "—" : (c.Description.Length > 60 ? c.Description.Substring(0, 60) + "…" : c.Description))</td>
                                <td class="d-none d-sm-table-cell">@(c.Products != null ? c.Products.Count : 0)</td>
                                <td class="text-nowrap">
                                    @Html.ActionLink("✏️", "EditCategory", "Admin", new { id = c.Id }, new { @class = "btn btn-outline-primary btn-sm" })
                                    @using (Html.BeginForm("DeleteCategory", "Admin", FormMethod.Post, new { @class = "d-inline" }))
                                    {
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="id" value="@c.Id" />
                                        <button type="submit" class="btn btn-outline-danger btn-sm" onclick="return confirm('Xóa danh mục \'@c.Name\'?');">🗑️</button>
                                    }
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr><td colspan="6" class="text-center text-muted py-3">Không tìm thấy danh mục nào.</td></tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

@Html.Partial("_Pagination")
