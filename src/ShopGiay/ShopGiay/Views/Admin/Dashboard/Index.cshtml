@model ShopGiay.Models.AdminDashboardViewModel
@{
    ViewBag.Title = "Admin Dashboard";
    var revenueJson = "[" + string.Join(",", Model.MonthlyRevenue.Select(r => r.ToString(System.Globalization.CultureInfo.InvariantCulture))) + "]";
    var ordersJson = "[" + string.Join(",", Model.MonthlyOrders) + "]";
    var labelsJson = "[" + string.Join(",", Model.MonthLabels.Select(l => "\"" + l + "\"")) + "]";
}

<!-- ── Tiêu đề + nút điều hướng ─────────────────────────────────── -->
<div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-4">
    <h2 class="fw-bold mb-0">📊 Admin Dashboard</h2>
    <div class="d-flex flex-wrap gap-2">
        @Html.ActionLink("👥 Người dùng", "Users", "Admin", null, new { @class = "btn btn-outline-primary btn-sm" })
        @Html.ActionLink("📦 Đơn hàng", "Orders", "Admin", null, new { @class = "btn btn-outline-success btn-sm" })
        @Html.ActionLink("👟 Sản phẩm", "Products", "Admin", null, new { @class = "btn btn-outline-dark btn-sm" })
        @Html.ActionLink("📂 Danh mục", "Categories", "Admin", null, new { @class = "btn btn-outline-secondary btn-sm" })
    </div>
</div>

<!-- ── Thẻ thống kê ──────────────────────────────────────────────── -->
<div class="row g-3 mb-4">
    <div class="col-6 col-md-3">
        <div class="card stat-card border-0 shadow-sm text-center h-100">
            <div class="card-body py-3">
                <div class="stat-icon text-primary">👥</div>
                <div class="stat-value text-primary">@Model.TotalUsers</div>
                <div class="stat-label">Người dùng</div>
            </div>
        </div>
    </div>
    <div class="col-6 col-md-3">
        <div class="card stat-card border-0 shadow-sm text-center h-100">
            <div class="card-body py-3">
                <div class="stat-icon text-success">📦</div>
                <div class="stat-value text-success">@Model.TotalOrders</div>
                <div class="stat-label">Tổng đơn hàng</div>
            </div>
        </div>
    </div>
    <div class="col-6 col-md-3">
        <div class="card stat-card border-0 shadow-sm text-center h-100">
            <div class="card-body py-3">
                <div class="stat-icon text-warning">💰</div>
                <div class="stat-value text-warning">@Model.TotalRevenue.ToString("N0")₫</div>
                <div class="stat-label">Doanh thu (đã giao)</div>
            </div>
        </div>
    </div>
    <div class="col-6 col-md-3">
        <div class="card stat-card border-0 shadow-sm text-center h-100">
            <div class="card-body py-3">
                <div class="stat-icon text-danger">⏳</div>
                <div class="stat-value text-danger">@Model.PendingOrders</div>
                <div class="stat-label">Chờ xử lý</div>
            </div>
        </div>
    </div>
</div>

<!-- ── Biểu đồ ───────────────────────────────────────────────────── -->
<div class="row g-3 mb-4">
    <div class="col-lg-8">
        <div class="card border-0 shadow-sm h-100">
            <div class="card-header bg-white fw-bold border-bottom">
                📈 Doanh thu & Đơn hàng (6 tháng gần nhất)
            </div>
            <div class="card-body">
                <div class="chart-container">
                    <canvas id="revenueChart"></canvas>
                </div>
            </div>
        </div>
    </div>
    <div class="col-lg-4">
        <div class="card border-0 shadow-sm h-100">
            <div class="card-header bg-white fw-bold border-bottom">
                🍩 Trạng thái đơn hàng
            </div>
            <div class="card-body d-flex flex-column align-items-center justify-content-center">
                <div class="chart-container-sm">
                    <canvas id="statusChart"></canvas>
                </div>
                <div class="mt-3 w-100">
                    <div class="d-flex justify-content-between small mb-1">
                        <span><span class="badge" style="background:#ffc107">&nbsp;&nbsp;</span> Chờ xử lý</span>
                        <strong>@Model.StatusPending</strong>
                    </div>
                    <div class="d-flex justify-content-between small mb-1">
                        <span><span class="badge" style="background:#0dcaf0">&nbsp;&nbsp;</span> Đang xử lý</span>
                        <strong>@Model.StatusProcessing</strong>
                    </div>
                    <div class="d-flex justify-content-between small mb-1">
                        <span><span class="badge" style="background:#0d6efd">&nbsp;&nbsp;</span> Vận chuyển</span>
                        <strong>@Model.StatusShipped</strong>
                    </div>
                    <div class="d-flex justify-content-between small mb-1">
                        <span><span class="badge" style="background:#198754">&nbsp;&nbsp;</span> Đã giao</span>
                        <strong>@Model.StatusDelivered</strong>
                    </div>
                    <div class="d-flex justify-content-between small">
                        <span><span class="badge" style="background:#dc3545">&nbsp;&nbsp;</span> Đã hủy</span>
                        <strong>@Model.StatusCancelled</strong>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- ── Đơn hàng gần đây ──────────────────────────────────────────── -->
<div class="card border-0 shadow-sm">
    <div class="card-header bg-white fw-bold border-bottom d-flex justify-content-between align-items-center">
        <span>🕐 Đơn hàng gần đây</span>
        @Html.ActionLink("Xem tất cả →", "Orders", "Admin", null, new { @class = "btn btn-sm btn-outline-success" })
    </div>
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover mb-0 admin-table">
                <thead class="table-light">
                    <tr>
                        <th>#</th>
                        <th>Khách hàng</th>
                        <th class="d-none d-md-table-cell">Tổng tiền</th>
                        <th>Trạng thái</th>
                        <th class="d-none d-sm-table-cell">Ngày tạo</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model.RecentOrders != null && Model.RecentOrders.Count > 0)
                    {
                        foreach (var o in Model.RecentOrders)
                        {
                            <tr>
                                <td>@o.Id</td>
                                <td>@o.FullName</td>
                                <td class="d-none d-md-table-cell">@o.TotalAmount.ToString("N0")₫</td>
                                <td>@Html.Partial("_OrderStatusBadge", o.Status)</td>
                                <td class="d-none d-sm-table-cell">@o.CreatedAt.ToString("dd/MM/yyyy")</td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr><td colspan="5" class="text-center text-muted py-3">Chưa có đơn hàng nào.</td></tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

@section scripts {
    <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.0/dist/chart.umd.min.js"></script>
    <script>
        (function () {
            var labels = @Html.Raw(labelsJson);
            var revenue = @Html.Raw(revenueJson);
            var orders = @Html.Raw(ordersJson);

            // Biểu đồ doanh thu + số đơn
            var ctx1 = document.getElementById('revenueChart').getContext('2d');
            new Chart(ctx1, {
                type: 'bar',
                data: {
                    labels: labels,
                    datasets: [
                        {
                            label: 'Doanh thu (₫)',
                            data: revenue,
                            backgroundColor: 'rgba(25,135,84,0.7)',
                            borderColor: '#198754',
                            borderWidth: 1,
                            yAxisID: 'yRevenue',
                            order: 2
                        },
                        {
                            label: 'Số đơn',
                            data: orders,
                            type: 'line',
                            borderColor: '#0d6efd',
                            backgroundColor: 'rgba(13,110,253,0.15)',
                            borderWidth: 2,
                            pointRadius: 4,
                            fill: true,
                            tension: 0.3,
                            yAxisID: 'yOrders',
                            order: 1
                        }
                    ]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    interaction: { mode: 'index', intersect: false },
                    plugins: { legend: { position: 'bottom' } },
                    scales: {
                        yRevenue: {
                            type: 'linear',
                            position: 'left',
                            ticks: {
                                callback: function (v) {
                                    return v >= 1000000
                                        ? (v / 1000000).toFixed(1) + 'M₫'
                                        : v.toLocaleString('vi-VN') + '₫';
                                }
                            }
                        },
                        yOrders: {
                            type: 'linear',
                            position: 'right',
                            grid: { drawOnChartArea: false },
                            ticks: { stepSize: 1 }
                        }
                    }
                }
            });

            // Biểu đồ trạng thái (doughnut)
            var ctx2 = document.getElementById('statusChart').getContext('2d');
            new Chart(ctx2, {
                type: 'doughnut',
                data: {
                    labels: ['Chờ xử lý', 'Đang xử lý', 'Vận chuyển', 'Đã giao', 'Đã hủy'],
                    datasets: [{
                        data: [@Model.StatusPending, @Model.StatusProcessing, @Model.StatusShipped, @Model.StatusDelivered, @Model.StatusCancelled],
                        backgroundColor: ['#ffc107', '#0dcaf0', '#0d6efd', '#198754', '#dc3545'],
                        borderWidth: 2,
                        borderColor: '#fff'
                    }]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    plugins: {
                        legend: { display: false },
                        tooltip: {
                            callbacks: {
                                label: function (ctx) {
                                    return ' ' + ctx.label + ': ' + ctx.raw + ' đơn';
                                }
                            }
                        }
                    },
                    cutout: '65%'
                }
            });
        })();
    </script>
}

