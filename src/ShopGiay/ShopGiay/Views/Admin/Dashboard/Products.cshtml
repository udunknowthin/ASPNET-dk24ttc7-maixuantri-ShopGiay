@model ShopGiay.Models.AdminProductListViewModel
@{
    ViewBag.Title = "Quản lý sản phẩm";
    ViewBag.PaginationPage = Model.Page;
    ViewBag.PaginationTotalPages = Model.TotalPages;
    ViewBag.PaginationAction = "Products";
    ViewBag.PaginationController = "Admin";
    ViewBag.PaginationRouteValues = new System.Collections.Generic.Dictionary<string, object>
    {
        { "keyword",    Model.SearchKeyword },
        { "categoryId", Model.CategoryId.HasValue ? (object)Model.CategoryId.Value : null }
    };
}

<div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-4">
    <h2 class="fw-bold mb-0">👟 Quản lý sản phẩm</h2>
    <div class="d-flex gap-2">
        @Html.ActionLink("+ Thêm sản phẩm", "CreateProduct", "Admin", null, new { @class = "btn btn-success btn-sm" })
        @Html.ActionLink("← Dashboard", "Index", "Admin", null, new { @class = "btn btn-outline-secondary btn-sm" })
    </div>
</div>

<!-- Bộ lọc -->
<div class="card border-0 shadow-sm mb-4">
    <div class="card-body">
        @using (Html.BeginForm("Products", "Admin", FormMethod.Get, new { @class = "row g-2 align-items-end" }))
        {
            <div class="col-12 col-md-5">
                <label class="form-label fw-semibold">Từ khóa</label>
                <input type="text" name="keyword" value="@Model.SearchKeyword" class="form-control" placeholder="Tên sản phẩm hoặc SKU..." />
            </div>
            <div class="col-12 col-md-4">
                <label class="form-label fw-semibold">Danh mục</label>
                <select name="categoryId" class="form-select">
                    <option value="">-- Tất cả --</option>
                    @foreach (var c in Model.Categories)
                    {
                        <option value="@c.Id" @(Model.CategoryId == c.Id ? "selected" : "")>@c.Name</option>
                    }
                </select>
            </div>
            <div class="col-12 col-md-3">
                <button type="submit" class="btn btn-primary w-100">🔍 Tìm kiếm</button>
            </div>
        }
    </div>
</div>

<div class="d-flex justify-content-between align-items-center mb-2 small text-muted">
    <span>Tổng: <strong>@Model.TotalCount</strong> sản phẩm — Trang <strong>@Model.Page</strong>/@Model.TotalPages</span>
</div>

<!-- Bảng sản phẩm -->
<div class="card border-0 shadow-sm">
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0 admin-table">
                <thead class="table-light">
                    <tr>
                        <th style="width:60px">Ảnh</th>
                        <th>SKU</th>
                        <th>Tên sản phẩm</th>
                        <th class="d-none d-md-table-cell">Danh mục</th>
                        <th>Giá</th>
                        <th class="d-none d-sm-table-cell">Giảm giá</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model.Products != null && Model.Products.Count > 0)
                    {
                        foreach (var p in Model.Products)
                        {
                            var img = p.Images != null && p.Images.Any() ? p.Images.First().ImageUrl : null;
                            var finalPrice = p.IsDiscounted ? p.Price * (decimal)(1 - p.DiscountPercentage / 100.0) : p.Price;
                            <tr>
                                <td>
                                    @if (img != null)
                                    {
                                        <img src="@Url.Content("~/Content/images/products/" + p.SKU + "/" + img)"
                                             alt="@p.Name" class="rounded" style="width:48px;height:48px;object-fit:cover;" />
                                    }
                                    else
                                    {
                                        <div class="bg-light rounded d-flex align-items-center justify-content-center" style="width:48px;height:48px;font-size:1.5rem;">👟</div>
                                    }
                                </td>
                                <td><code>@p.SKU</code></td>
                                <td>
                                    <div class="fw-semibold">@p.Name</div>
                                    <div class="text-muted small d-md-none">@(p.Category != null ? p.Category.Name : "")</div>
                                </td>
                                <td class="d-none d-md-table-cell">@(p.Category != null ? p.Category.Name : "—")</td>
                                <td class="text-nowrap">
                                    @if (p.IsDiscounted)
                                    {
                                        <div><span class="text-decoration-line-through text-muted small">@p.Price.ToString("N0")₫</span></div>
                                        <div class="text-danger fw-bold">@finalPrice.ToString("N0")₫</div>
                                    }
                                    else
                                    {
                                        <span class="fw-bold">@p.Price.ToString("N0")₫</span>
                                    }
                                </td>
                                <td class="d-none d-sm-table-cell">
                                    @if (p.IsDiscounted)
                                    {
                                        <span class="badge bg-danger">-@p.DiscountPercentage%</span>
                                    }
                                    else
                                    {
                                        <span class="text-muted">—</span>
                                    }
                                </td>
                                <td>
                                    <div class="d-flex gap-1">
                                        @Html.ActionLink("✏️", "EditProduct", "Admin", new { id = p.Id }, new { @class = "btn btn-sm btn-outline-primary", title = "Chỉnh sửa" })
                                        @using (Html.BeginForm("DeleteProduct", "Admin", FormMethod.Post, new { @class = "d-inline", onsubmit = "return confirm('Xóa sản phẩm \"" + p.Name + "\"?')" }))
                                        {
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="id" value="@p.Id" />
                                            <button type="submit" class="btn btn-sm btn-outline-danger" title="Xóa">🗑️</button>
                                        }
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr><td colspan="7" class="text-center text-muted py-4">Không tìm thấy sản phẩm nào.</td></tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

@Html.Partial("_Pagination")
