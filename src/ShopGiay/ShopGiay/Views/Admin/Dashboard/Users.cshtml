@model ShopGiay.Models.AdminUserListViewModel
@{
    ViewBag.Title = "Quản lý người dùng";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2 class="fw-bold mb-0">👥 Quản lý người dùng</h2>
    @Html.ActionLink("← Quay lại Dashboard", "Index", "Admin", null, new { @class = "btn btn-outline-secondary" })
</div>

<div class="card border-0 shadow-sm mb-4">
    <div class="card-body">
        @using (Html.BeginForm("Users", "Admin", FormMethod.Get, new { @class = "row g-2 align-items-end" }))
        {
            <div class="col-md-8">
                <label class="form-label fw-semibold">Tìm kiếm</label>
                <input type="text" name="keyword" value="@Model.SearchKeyword" class="form-control" placeholder="Email hoặc họ tên..." />
            </div>
            <div class="col-md-4">
                <button type="submit" class="btn btn-primary w-100">🔍 Tìm kiếm</button>
            </div>
        }
    </div>
</div>

<div class="card border-0 shadow-sm">
    <div class="card-body p-0">
        <table class="table table-hover mb-0">
            <thead class="table-light">
                <tr>
                    <th>Email</th>
                    <th>Họ tên</th>
                    <th>SĐT</th>
                    <th>Địa chỉ</th>
                    <th>Vai trò</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @if (Model.Users != null && Model.Users.Count > 0)
                {
                    foreach (var u in Model.Users)
                    {
                        <tr>
                            <td>@u.Email</td>
                            <td>@(string.IsNullOrEmpty(u.FullName) ? "—" : u.FullName)</td>
                            <td>@(string.IsNullOrEmpty(u.PhoneNumber) ? "—" : u.PhoneNumber)</td>
                            <td>@(string.IsNullOrEmpty(u.Address) ? "—" : u.Address)</td>
                            <td>
                                @if (u.IsAdmin)
                                {
                                    <span class="badge bg-danger">Admin</span>
                                }
                                else
                                {
                                    <span class="badge bg-secondary">User</span>
                                }
                            </td>
                            <td>
                                @Html.ActionLink("✏️ Sửa", "EditUser", "Admin", new { id = u.Id }, new { @class = "btn btn-sm btn-outline-primary" })
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr><td colspan="6" class="text-center text-muted py-3">Không tìm thấy người dùng.</td></tr>
                }
            </tbody>
        </table>
    </div>
</div>
