@model ShopGiay.Models.CheckoutViewModel
@{
    ViewBag.Title = "Xác nhận đặt hàng";
    var cartItems = Model.CartItems ?? new List<ShopGiay.Models.CartItem>();
}

<nav aria-label="breadcrumb" class="mb-3">
    <ol class="breadcrumb">
        <li class="breadcrumb-item">@Html.ActionLink("Trang chủ", "Index", "Home")</li>
        <li class="breadcrumb-item">@Html.ActionLink("Giỏ hàng", "Detail", "Cart")</li>
        <li class="breadcrumb-item active">Xác nhận đặt hàng</li>
    </ol>
</nav>

<h2 class="section-heading mb-4">Xác nhận đặt hàng</h2>

@if (!cartItems.Any())
{
    <div class="alert alert-warning rounded-3">
        🛒 Giỏ hàng của bạn đang trống. <a href="@Url.Action("Index", "Home")" class="fw-bold">Tiếp tục mua sắm</a>.
    </div>
}
else
{
    <div class="row g-4">
        <!-- Form thông tin giao hàng -->
        <div class="col-lg-7">
            <div class="checkout-card card p-4">
                <h5 class="fw-bold mb-4">📦 Thông tin giao hàng</h5>
                @using (Html.BeginForm("PlaceOrder", "Checkout", FormMethod.Post))
                {
                    @Html.AntiForgeryToken()
                    @Html.ValidationSummary(true, "", new { @class = "alert alert-danger rounded-3" })

                    <div class="mb-3">
                        <label class="form-label">Họ và tên</label>
                        @Html.TextBoxFor(m => m.FullName, new { @class = "form-control", placeholder = "Nguyễn Văn A" })
                        @Html.ValidationMessageFor(m => m.FullName, "", new { @class = "text-danger small" })
                    </div>

                    <div class="mb-3">
                        <label class="form-label">Email</label>
                        @Html.TextBoxFor(m => m.Email, new { @class = "form-control", @readonly = "readonly" })
                        @Html.ValidationMessageFor(m => m.Email, "", new { @class = "text-danger small" })
                    </div>

                    <div class="mb-3">
                        <label class="form-label">Số điện thoại</label>
                        @Html.TextBoxFor(m => m.PhoneNumber, new { @class = "form-control", placeholder = "0912 345 678" })
                        @Html.ValidationMessageFor(m => m.PhoneNumber, "", new { @class = "text-danger small" })
                    </div>

                    <div class="mb-3">
                        <label class="form-label">Địa chỉ giao hàng</label>
                        @Html.TextAreaFor(m => m.Address, new { @class = "form-control", rows = 2, placeholder = "Số nhà, đường, phường/xã, quận/huyện, tỉnh/thành phố" })
                        @Html.ValidationMessageFor(m => m.Address, "", new { @class = "text-danger small" })
                    </div>

                    <div class="mb-3">
                        <label class="form-label">Ghi chú <span class="text-muted fw-normal">(không bắt buộc)</span></label>
                        @Html.TextAreaFor(m => m.Notes, new { @class = "form-control", rows = 2, placeholder = "Ghi chú thêm cho đơn hàng..." })
                    </div>

                    <div class="mb-4">
                        <label class="form-label">Phương thức thanh toán</label>
                        <select name="PaymentMethod" class="form-select">
                            <option value="COD" selected>💵 Thanh toán khi nhận hàng (COD)</option>
                            <option value="BankTransfer">🏦 Chuyển khoản ngân hàng</option>
                        </select>
                    </div>

                    <button type="submit" class="btn btn-dark btn-lg w-100 py-3 fw-bold">
                        🛍️ Đặt hàng ngay
                    </button>
                }
            </div>
        </div>

        <!-- Tóm tắt đơn hàng -->
        <div class="col-lg-5">
            <div class="checkout-card card">
                <div class="card-header bg-dark text-white py-3">
                    <h5 class="mb-0 fw-bold">🧾 Tóm tắt đơn hàng</h5>
                </div>
                <div class="card-body p-4">
                    @foreach (var ci in cartItems)
                    {
                        var product = ci.Product;
                        decimal unitPrice = 0;
                        if (product != null)
                        {
                            unitPrice = product.IsDiscounted
                                ? product.Price * (decimal)(1 - product.DiscountPercentage / 100.0)
                                : product.Price;
                        }
                        var lineTotal = unitPrice * ci.Quantity;

                        <div class="d-flex justify-content-between align-items-start mb-3">
                            <div>
                                <div class="fw-semibold" style="font-size:.9rem">@(product != null ? product.Name : "Sản phẩm")</div>
                                <small class="text-muted">
                                    Size: <span class="badge bg-secondary">@(ci.ProductSize != null ? ci.ProductSize.SizeName : "-")</span>
                                    &times; @ci.Quantity
                                </small>
                            </div>
                            <span class="fw-semibold text-nowrap ms-2">
                                @if (product != null && product.IsDiscounted)
                                {
                                    <span class="price-old">@product.Price.ToString("N0") ₫</span>
                                    <span class="price-new ms-1">@(lineTotal.ToString("N0") + " ₫")</span>
                                    <span class="badge bg-danger ms-2">-@product.DiscountPercentage%</span>
                                }
                                else
                                {
                                    @(lineTotal.ToString("N0") + " ₫")
                                }
                            </span>
                        </div>
                    }
                    <hr />
                    <div class="d-flex justify-content-between mb-2 text-muted">
                        <span>Phí vận chuyển</span>
                        <span class="text-success fw-semibold">Miễn phí</span>
                    </div>
                    <div class="d-flex justify-content-between fw-bold fs-5 mt-2">
                        <span>Tổng cộng</span>
                        <span class="text-danger">@(Model.Subtotal.ToString("N0") + " ₫")</span>
                    </div>
                </div>
            </div>

            <div class="mt-3 p-3 bg-light rounded-3 small text-muted">
                ✅ Hàng chính hãng 100%<br />
                🚚 Giao hàng toàn quốc 2–5 ngày<br />
                🔄 Đổi trả miễn phí trong 7 ngày
            </div>
        </div>
    </div>
}

@section scripts {
    @Scripts.Render("~/bundles/jqueryval")
}
