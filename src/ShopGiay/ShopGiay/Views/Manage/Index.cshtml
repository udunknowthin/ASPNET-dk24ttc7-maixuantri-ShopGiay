@model ShopGiay.Models.IndexViewModel
@{
    ViewBag.Title = "Quản lý tài khoản";
}

<main aria-labelledby="title">
    <h2 id="title">@ViewBag.Title</h2>

    @if (!string.IsNullOrEmpty(ViewBag.StatusMessage))
    {
        <div class="alert @(ViewBag.StatusClass ?? "alert-success")">@ViewBag.StatusMessage</div>
    }
    <div>
        <h4>Thông tin tài khoản</h4>
        <hr />
        <div class="row">
            <div class="col-md-6">
                <form method="post" action="@Url.Action("UpdateProfile", "Manage")">
                    @Html.AntiForgeryToken()
                    <div class="mb-3">
                        <label class="form-label">Họ và tên</label>
                        <input name="FullName" class="form-control" value="@Model.FullName" />
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Địa chỉ</label>
                        <input name="Address" class="form-control" value="@Model.Address" />
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Số điện thoại</label>
                        <input name="PhoneNumber" class="form-control" value="@Model.PhoneNumber" />
                    </div>
                    <button class="btn btn-dark">Cập nhật thông tin</button>
                </form>
            </div>
            <div class="col-md-6">
                <h5>Mật khẩu</h5>
                <p>
                    @if (Model.HasPassword)
                    {
                        @Html.ActionLink("Đổi mật khẩu", "ChangePassword", null, new { @class = "btn btn-link" })
                    }
                </p>
            </div>
        </div>
    </div>

    <hr />
    <h4>Đơn hàng của bạn</h4>
    @if (Model.Orders != null && Model.Orders.Any())
    {
        <div class="list-group">
            @foreach (var o in Model.Orders)
            {
                <a class="list-group-item list-group-item-action" href="@Url.Action("Details", "Orders", new { id = o.Id })">
                    <div class="d-flex w-100 justify-content-between">
                        <h5 class="mb-1">#@o.Id</h5>
                        <small>@o.CreatedAt.ToString("g")</small>
                    </div>
                    <p class="mb-1">Tổng: @string.Format("{0:N0} ₫", o.TotalAmount) — Trạng thái: @o.Status</p>
                </a>
            }
        </div>
    }
    else
    {
        <p class="text-muted">Bạn chưa có đơn hàng nào.</p>
    }
</main>