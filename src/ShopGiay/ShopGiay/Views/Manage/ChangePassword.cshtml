@model ShopGiay.Models.ChangePasswordViewModel
@{
    ViewBag.Title = "Đổi mật khẩu";
}

<main aria-labelledby="title">
    <div class="auth-card change-password-card mx-auto">
        <div class="text-center mb-4">
            <h2 id="title">@ViewBag.Title</h2>
            <p class="text-muted small">Thay đổi mật khẩu tài khoản của bạn</p>
        </div>

        @using (Html.BeginForm("ChangePassword", "Manage", FormMethod.Post, new { role = "form" }))
        {
            @Html.AntiForgeryToken()
            @Html.ValidationSummary("", new { @class = "text-danger" })

            <div class="mb-3">
                <label class="form-label">Mật khẩu hiện tại</label>
                @Html.PasswordFor(m => m.OldPassword, new { @class = "form-control" })
            </div>
            <div class="mb-3">
                <label class="form-label">Mật khẩu mới</label>
                @Html.PasswordFor(m => m.NewPassword, new { @class = "form-control" })
            </div>
            <div class="mb-3">
                <label class="form-label">Xác nhận mật khẩu mới</label>
                @Html.PasswordFor(m => m.ConfirmPassword, new { @class = "form-control" })
            </div>

            <div class="text-end">
                <input type="submit" value="Đổi mật khẩu" class="btn btn-dark" />
            </div>
        }
    </div>
</main>

@section Scripts {
    @Scripts.Render("~/bundles/jqueryval")
}